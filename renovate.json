{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^hack/agent-sandbox-version$/"],
      "matchStrings": ["(?<currentValue>v[^\\n]+)"],
      "depNameTemplate": "kubernetes-sigs/agent-sandbox",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["kubernetes-sigs/agent-sandbox"],
      "postUpgradeTasks": {
        "commands": ["hack/update-upstream.sh {{newVersion}}"],
        "fileFilters": [
          "helm/mogenius-agent-sandbox/crds/**",
          "helm/mogenius-agent-sandbox/Chart.yaml"
        ],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": ["!github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": ["!github-actions"],
      "matchUpdateTypes": ["minor"],
      "semanticCommitType": "feat"
    },
    {
      "matchManagers": ["!github-actions"],
      "matchUpdateTypes": ["major"],
      "semanticCommitType": "feat",
      "commitBody": "BREAKING CHANGE: Major update of {{depName}} to {{newVersion}}"
    }
  ]
}
